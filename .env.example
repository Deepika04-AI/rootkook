# Required: your Anthropic API key (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: which Claude models to use
CARD_MODEL=claude-sonnet-5-5
CHAT_MODEL=claude-haiku-4-5-20251001

# Optional: community table + shared rate limiting (Upstash Redis, free tier).
# On Vercel, adding the Upstash Redis integration fills these in for you.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Required if you use the community table: password for /admin.html
ADMIN_KEY=choose-a-long-random-password

# Optional: spending guards
RATE_LIMIT_PER_HOUR=60
DAILY_CALL_CAP=2000

# Local testing without a key: canned AI answers
# MOCK_AI=1
